<Window
    x:Class="Wpf.Container.Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Container.Test"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:regionmanager="clr-namespace:Eye.Base.Region;assembly=Wpf.Container"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" regionmanager:RegionManager.RegionName="MainRegion" />
        <StackPanel Grid.Row="1">
            <Button Command="{Binding ClickCommand}" Height="50" Grid.Row="1"/>
            <Button Content="AView" Command="{Binding MainView1Command}" Height="50" Grid.Row="1"/>
            <Button Content="BView" Command="{Binding MainView2Command}" Height="50" Grid.Row="1"/>
            <Button Content="GoBack" Command="{Binding GoBackCommand}" Height="50" Grid.Row="1"/>
        </StackPanel>
            
        
    </Grid>
</Window>
