<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-windows;net8.0-windows;net9.0-windows</TargetFrameworks>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>Wpf.Container</Title>
		<Authors>Mario</Authors>
		<Company>Real</Company>
		<Description>DialogService, NavigationService</Description>
		<PackageTags>7.0;8.0;9.0;10.0</PackageTags>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>1.3.5</Version>
	</PropertyGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Container.Core\Container.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="자산 3@4x.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</Resource>
	</ItemGroup>
	
	<!-- .NET 7용 패키지 참조 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net7.0-windows'">
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="7.0.0" />
	</ItemGroup>

	<!-- .NET 8용 패키지 참조 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
	</ItemGroup>

	<!-- .NET 9용 패키지 참조 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
	</ItemGroup>
</Project>