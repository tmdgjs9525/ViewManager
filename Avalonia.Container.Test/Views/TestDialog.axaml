<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="500" Height="400"
             x:Class="Avalonia.Container.Test.TestDialog">
  <Grid RowDefinitions="1*,1*,9*">
      <Border x:Name="border" Background="white"/>
	  <Button Foreground="Black" Content="X" Command="{Binding ExitCommand}" Background="Yellow"/>
      <TextBlock Text="TestDialog" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"/>
  </Grid>
</UserControl>
